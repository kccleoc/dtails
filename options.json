{
  "meta": {
    "saw": false
  },
  "add_software": {
    "categories": [
      {
        "key": "bitcoin",
        "title": "Bitcoin",
        "icon": "img/btc.svg",
        "menu_file": "Bitcoin.menu",
        "items": [
          {
            "name": "Bitcoin Core",
            "version": "31.1",
            "size_mb": 86.1,
            "external_commands": [
              "wget -q https://bitcoincore.org/bin/bitcoin-core-{version}/bitcoin-{version}-x86_64-linux-gnu.tar.gz -P shared_with_chroot",
              "wget -q https://raw.githubusercontent.com/bitcoin/bitcoin/master/share/pixmaps/bitcoin256.png -P shared_with_chroot",
              "cp dotfiles/dotdesktop/bitcoincore.desktop shared_with_chroot/"
            ],
            "internal_commands": [
              "mkdir -p /opt/bitcoin/",
              "cp /tmp/bitcoincore.desktop /usr/share/applications/",
              "cp /tmp/bitcoin256.png /opt/bitcoin/bitcoin256.png",
              "tar xzf /tmp/bitcoin-{version}-x86_64-linux-gnu.tar.gz -C /opt/bitcoin --strip-components=1"
            ]
          },
          {
            "name": "Sparrow Wallet",
            "version": "2.5.5",
            "size_mb": 98.2,
            "external_commands": [
              "wget -q https://github.com/sparrowwallet/sparrow/releases/download/{version}/sparrowwallet-{version}-x86_64.tar.gz -P shared_with_chroot",
              "cp dotfiles/dotdesktop/sparrow.desktop shared_with_chroot/"
            ],
            "internal_commands": [
              "tar -xvf /tmp/sparrowwallet-{version}-x86_64.tar.gz -C /opt",
              "cp /tmp/sparrow.desktop /usr/share/applications/"
            ]
          },
          {
            "name": "Specter Desktop",
            "version": "2.1.11",
            "size_mb": 112,
            "external_commands": [
              "wget -q https://github.com/cryptoadvance/specter-desktop/releases/download/v{version}/specter_desktop-v{version}-x86_64-linux-gnu.tar.gz -P shared_with_chroot",
              "wget -q -O shared_with_chroot/specter_logo.png https://raw.githubusercontent.com/cryptoadvance/specter-desktop/72fed92dd5d00e3164adcc97decf5ae03328538a/src/cryptoadvance/specter/static/img/v1-icons/icon.png",
              "wget -q -O shared_with_chroot/NotoColorEmoji.ttf https://raw.githubusercontent.com/googlefonts/noto-emoji/main/fonts/NotoColorEmoji.ttf",
              "cp dotfiles/dotconf/ferm_specter.conf shared_with_chroot/",
              "cp dotfiles/dotdesktop/specter.desktop shared_with_chroot/"
            ],
            "internal_commands": [
              "cd /tmp/ ; tar -zxvf specter_desktop-v{version}-x86_64-linux-gnu.tar.gz",
              "mkdir -p /opt/specter/",
              "cp /tmp/specter_logo.png /opt/specter/logo.png",
              "cp /tmp/Specter-*.AppImage /opt/specter/Specter.AppImage",
              "cp /tmp/udev/*.rules /etc/udev/rules.d/",
              "mkdir -p /etc/skel/.fonts/",
              "cp /tmp/NotoColorEmoji.ttf /etc/skel/.fonts/NotoColorEmoji.ttf",
              "mv /tmp/ferm_specter.conf /etc/ferm/ferm.conf",
              "cp /tmp/specter.desktop /usr/share/applications/"
            ]
          },
          {
            "name": "Bisq",
            "version": "1.10.8",
            "size_mb": 413,
            "external_commands": [
              "wget -q https://bisq.network/downloads/v{version}/Bisq-64bit-{version}.deb -P shared_with_chroot",
              "cp dotfiles/scripts/setup_bisq shared_with_chroot/"
            ],
            "internal_commands": [
              "dpkg -i /tmp/Bisq-64bit-{version}.deb",
              "/tmp/./setup_bisq"
            ]
          },
          {
            "name": "Liana Wallet",
            "version": "16.0rc1",
            "size_mb": 26.3,
            "external_commands": [
              "wget -q https://github.com/wizardsardine/liana/releases/download/v{version}/liana-{version}-x86_64-linux-gnu.tar.gz -P shared_with_chroot",
              "cp dotfiles/logos/liana.svg shared_with_chroot/",
              "cp dotfiles/dotdesktop/liana.desktop shared_with_chroot/"
            ],
            "internal_commands": [
              "mkdir /opt/liana/ && tar -xvf /tmp/liana-{version}-x86_64-linux-gnu.tar.gz -C /opt/liana/ --strip-components 1",
              "cp /tmp/liana.svg /opt/liana/",
              "cp /tmp/liana.desktop /usr/share/applications/"
            ]
          },
          {
            "name": "Mempool.space (web launcher)",
            "version": "1.0",
            "size_mb": 1,
            "external_commands": [
              "cp dotfiles/dotdesktop/mempool_space.desktop shared_with_chroot/",
              "cp dotfiles/logos/mempool_space.png shared_with_chroot/"
            ],
            "internal_commands": [
              "cp /tmp/mempool_space.desktop /usr/share/applications/",
              "mkdir -p /opt/logos/",
              "cp /tmp/mempool_space.png /opt/logos/"
            ]
          },
          {
            "name": "BIP39 (iancoleman) offline",
            "version": "0.5.6",
            "size_mb": 4.34,
            "external_commands": [
              "wget -q https://github.com/iancoleman/bip39/releases/download/{version}/bip39-standalone.html -P shared_with_chroot",
              "cp dotfiles/dotdesktop/bip39ian.desktop shared_with_chroot/"
            ],
            "internal_commands": [
              "cp /tmp/bip39ian.desktop /usr/share/applications/",
              "mkdir -p /etc/skel/Documents/",
              "cp /tmp/bip39-standalone.html /etc/skel/Documents/"
            ]
          },
          {
            "name": "Seedtool (offline)",
            "version": "2.4.0",
            "size_mb": 6.58,
            "external_commands": [
              "wget -q -O shared_with_chroot/seedtool.html https://github.com/BitcoinQnA/seedtool/releases/download/{version}/index.html",
              "cp dotfiles/dotdesktop/seedtool.desktop shared_with_chroot/",
              "cp dotfiles/logos/seedtool.png shared_with_chroot/"
            ],
            "internal_commands": [
              "cp /tmp/seedtool.desktop /usr/share/applications/",
              "mkdir -p /etc/skel/Documents/",
              "cp /tmp/seedtool.html /etc/skel/Documents/",
              "mkdir -p /opt/logos/",
              "cp /tmp/seedtool.png /opt/logos/"
            ]
          }
        ]
      }
    ]
  },
  "remove_software": [
    {
      "name": "GIMP",
      "internal_commands": "dpkg -r --force-depends gimp",
      "size": "160 MB"
    }
  ],
  "clean_system": {
    "message": "This will perform system cleanup and mark the intro as seen.",
    "commands": [
      "sudo losetup -l -n -O NAME 2>/dev/null | xargs -r -I{} sudo kpartx -dv {} 2>/dev/null || true",
      "sudo losetup -D 2>/dev/null || true",
      "sed -i 's/\\\"saw\\\"[[:space:]]*:[[:space:]]*true/\\\"saw\\\": false/' options.json",
      "sudo rm -rf shared_with_chroot/ system_to_edit/ iso_mounted/ future_iso/ squashfs-root/ mount_p/"
    ]
  }
}
